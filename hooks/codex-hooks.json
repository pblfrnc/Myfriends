{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex watch",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex watch",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/hook.js\" codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}